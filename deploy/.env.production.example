# Copie ce fichier en .env sur le VPS, à côté de docker-compose.prod.yml.
# Génère chaque secret avec : openssl rand -base64 48

POSTGRES_USER=snowwild
POSTGRES_PASSWORD=
POSTGRES_DB=snowwild

JWT_SECRET=

# Adresse publique du site (sert aux redirections Stripe et au CORS)
FRONTEND_URL=https://snow-wild.laurent-vuillaume.ovh

# Premier administrateur, créé au premier démarrage (12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Photos : Cloudinary (offre gratuite). Sans cette valeur, les photos restent sur le disque du VPS.
# Tableau de bord Cloudinary > « API Keys » : copier l'« API environment variable ».
CLOUDINARY_URL=
# Dossier des photos dans la médiathèque (facultatif)
CLOUDINARY_FOLDER=my-snow-wild-images

# Stripe (mode test) — sans clé, le paiement est simulé
STRIPE_SECRET_KEY=
# Clé publiable (pk_test_…), pour le formulaire de carte intégré au site
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Nom du réseau Docker du Caddy existant (docker network ls)
PROXY_NETWORK=vps-infra_web

# --- Factures (facultatif) ---------------------------------------------------
# Émetteur imprimé sur les factures PDF. Sans ces variables : entreprise fictive
# et mention « document fictif » sur chaque facture (COMPANY_DEMO=false pour la retirer).
# COMPANY_NAME=Snow Wild SAS
# COMPANY_ADDRESS=12 place des Glaciers
# COMPANY_POSTAL_CODE=73320
# COMPANY_CITY=Tignes
# COMPANY_EMAIL=contact@snowwild.dev
# COMPANY_SIRET=000 000 000 00000
# COMPANY_VAT_NUMBER=FR00000000000
# COMPANY_LEGAL_FORM=SAS au capital de 10 000 €
# COMPANY_RCS=RCS Chambéry
# COMPANY_DEMO=true
