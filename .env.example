# Copie ce fichier en .env et remplace les valeurs.

# Base de données PostgreSQL
POSTGRES_USER=snowwild
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=snowwild

# Authentification : au moins 32 caractères aléatoires (openssl rand -base64 48)
JWT_SECRET=change-moi-avec-au-moins-32-caracteres-aleatoires

# Premier administrateur, créé au démarrage s'il n'en existe aucun (mot de passe : 12 caractères minimum)
ADMIN_EMAIL=admin@snowwild.dev
ADMIN_PASSWORD=change-moi-12-caracteres

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@snowwild.dev
PGADMIN_PASSWORD=change-moi

# Photos sur Cloudinary (facultatif ; sans valeur : disque local, servi sous /uploads)
CLOUDINARY_URL=
# Dossier des photos dans la médiathèque (facultatif)
CLOUDINARY_FOLDER=my-snow-wild-images

# E-mails : sans RESEND_API_KEY, ils sont affichés dans les logs du backend
# (docker compose logs -f backend) au lieu d'être envoyés.
RESEND_API_KEY=
MAIL_FROM="Snow Wild <no-reply@snowwild.dev>"
