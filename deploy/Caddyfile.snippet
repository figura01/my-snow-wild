# À ajouter au Caddyfile de /srv/vps-infra, puis : docker compose restart caddy
# Le DNS de snow-wild.laurent-vuillaume.ovh doit pointer vers le VPS (51.91.99.187).
# Caddy obtient et renouvelle automatiquement le certificat HTTPS.

snow-wild.laurent-vuillaume.ovh {
	encode gzip

	# Notifications de paiement envoyées par Stripe : directement à l'API.
	handle /stripe/* {
		reverse_proxy snow-wild-backend:4000
	}

	# Tout le reste (pages et /graphql, relayé par Next.js) : le front.
	handle {
		reverse_proxy snow-wild-frontend:3000
	}
}
