{
  "name": "snow-wild-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API GraphQL de Snow Wild : Express, Apollo Server, TypeGraphQL, TypeORM, PostgreSQL",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --poll src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:demo": "ts-node --transpile-only src/seed-demo.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "graphql": "^16.13.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.27",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
