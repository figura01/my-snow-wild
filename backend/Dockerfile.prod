# Image de production de l'API : compilation TypeScript, puis image finale
# avec uniquement le code compilé et les dépendances de production.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4000
# Les migrations sont appliquées automatiquement au démarrage (migrationsRun).
CMD ["node", "dist/index.js"]
