# Copie ce fichier en .env sur le VPS, à côté de docker-compose.prod.yml.
# Génère chaque secret avec : openssl rand -base64 48

POSTGRES_USER=snowwild
POSTGRES_PASSWORD=
POSTGRES_DB=snowwild

JWT_SECRET=

# Adresse publique du site (sert aux redirections Stripe et au CORS)
FRONTEND_URL=https://snow-wild.laurent-vuillaume.ovh

# Premier administrateur, créé au premier démarrage (12 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Photos : Cloudinary (offre gratuite). Sans cette valeur, les photos restent sur le disque du VPS.
# Tableau de bord Cloudinary > « API Keys » : copier l'« API environment variable ».
CLOUDINARY_URL=
# Dossier des photos dans la médiathèque (facultatif)
CLOUDINARY_FOLDER=my-snow-wild/materials

# Stripe (mode test) — sans clé, le paiement est simulé
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Nom du réseau Docker du Caddy existant (docker network ls)
PROXY_NETWORK=vps-infra_web
